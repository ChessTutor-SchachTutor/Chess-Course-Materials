[PlyCount "0"]

{Im Mittelspiel müssen die Türme müssen hinten stehen und vorsichtig sein.}  *

[Event "?"]
[Site "?"]
[Round "?"]
[White "Turm 3"]
[Black "Turmfreiheit im Endspiel"]
[Result "*"]
[Annotator "SchachTutor"]
[SetUp "1"]
